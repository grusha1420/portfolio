# Copy this file to `.env` and fill in the values.
# Schema: src/env.js — keep in sync when adding variables.

# ── Required ────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled URL recommended for serverless)
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Admin panel password — use a strong, unique value (12+ characters recommended)
ADMIN_PASSWORD=

# Session signing secret — separate from ADMIN_PASSWORD, min 32 characters
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Uploadthing credentials — https://uploadthing.com/dashboard
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Public site URL — required for production builds (SEO, sitemap, OG tags)
# Local dev: optional (defaults to http://localhost:3000)
# First Vercel deploy: https://your-project.vercel.app
# Custom domain: https://resurexi.com
NEXT_PUBLIC_SITE_URL=

# ── Optional ────────────────────────────────────────────────────────────────

# Cal.com booking — Book a Call CTA is hidden when unset
# Server-side embed URL (e.g. https://cal.com/your-username/30min)
CAL_COM_URL=

# Client-side Cal.com link (same URL as CAL_COM_URL if using embed)
NEXT_PUBLIC_CAL_COM_URL=
